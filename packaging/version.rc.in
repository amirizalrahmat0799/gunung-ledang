// Version information shown in the exe's Properties > Details tab on Windows.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Ahmad Amirizal Rahmat"
      VALUE "FileDescription", "Gunung Ledang"
      VALUE "FileVersion", "@LEDANG_VERSION@"
      VALUE "InternalName", "gunung_ledang"
      VALUE "LegalCopyright", "Copyright (c) Ahmad Amirizal Rahmat. Apache License 2.0."
      VALUE "OriginalFilename", "gunung_ledang.exe"
      VALUE "ProductName", "Gunung Ledang"
      VALUE "ProductVersion", "@LEDANG_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
